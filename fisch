-- Teleport helper
local function Teleport(cf)
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then root.CFrame = cf end
    end
end

-- Noclip loop
RunService.Stepped:Connect(function()
    if State.Noclip then
        local char = LocalPlayer.Character
        if char then
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end
end)

-- Freeze position
local function StartFreeze()
    task.spawn(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")
        local frozenCF = root.CFrame

        local bv = Instance.new("BodyVelocity")
        bv.Velocity  = Vector3.zero
        bv.MaxForce  = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent    = root

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.D = 100; bg.P = 10000
        bg.CFrame = frozenCF
        bg.Parent = root

        while State.AutoFreeze do
            root.CFrame = frozenCF
            task.wait(0.01)
        end
        bv:Destroy(); bg:Destroy()
    end)
end

-- Auto cast
local function StartAutoCast()
    task.spawn(function()
        while State.AutoCast do
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool and not tool:FindFirstChild("bobber") then
                    local castEvent = tool:FindFirstChild("events") and tool.events:FindFirstChild("cast")
                    if castEvent then
                        castEvent:FireServer(math.random(90, 99))
                    end
                end
            end
            task.wait(1)
        end
    end)
end

-- Auto reel (fires reelfinished when reel UI appears)
PlayerGui.ChildAdded:Connect(function(gui)
    if gui:IsA("ScreenGui") and gui.Name == "reel" and State.AutoReel then
        local ev = Link:WaitForChild("events"):FindFirstChild("reelfinished")
        if ev then
            task.spawn(function()
                while gui and gui.Parent do
                    task.wait(2)
                    ev:FireServer(100, false)
                end
            end)
        end
    end
end)

-- Auto shake (runs inside AutoFish loop)
local function RunShake()
    task.spawn(function()
        while State.AutoFish do
            local delay = State.AutoShake3 and 0 or State.AutoShakeDelay

            local gui   = PlayerGui:FindFirstChild("shakeui")
            if gui and gui.Enabled then
                local btn = gui:FindFirstChild("safezone") and
                            gui.safezone:FindFirstChild("button")
                if btn and btn:IsA("ImageButton") and btn.Visible then
                    if State.ShakeMode == "Mouse" then
                        local pos  = btn.AbsolutePosition
                        local size = btn.AbsoluteSize
                        local cx   = pos.X + size.X / 2
                        local cy   = pos.Y + size.Y / 2
                        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true,  LocalPlayer, 0)
                        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, LocalPlayer, 0)
                    elseif State.ShakeMode == "Phantom" then
                        GuiService.SelectedObject = btn
                        VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.Return, false, game)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                    end
                end
            end

            if delay > 0 then task.wait(delay) else task.wait() end
        end
    end)
end

-- Start full auto fish (cast + shake + reel toggled via flags)
local function StartAutoFish()
    State.AutoFish = true
    State.AutoCast = true
    State.AutoReel = true
    StartAutoCast()
    RunShake()
    -- Initial cast if rod already equipped
    local char = LocalPlayer.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool:FindFirstChild("events") and tool.events:FindFirstChild("cast") then
            tool.events.cast:FireServer(math.random(90, 99))
        end
    end
end

local function StopAutoFish()
    State.AutoFish = false
    State.AutoCast = false
    State.AutoReel = false
end

