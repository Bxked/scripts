            ["Whale Shark"]            = {name = "Whale Shark",            offset = Vector3.new(0, 135, 0)},
            ["The Depths - Serpent"]   = {name = "The Depths - Serpent",   offset = Vector3.new(0, 50, 0)},
        }
        local entry = eventMap[Value]
        if not entry then return end
        local WorldEvent = FishingZonesFolder:FindFirstChild(entry.name)
        if not WorldEvent then
            return ShowNotification("Not found: " .. Value)
        end
        HumanoidRootPart.CFrame = CFrame.new(WorldEvent.Position + entry.offset)
        ShowNotification("Teleported to " .. Value)
    end,
})

