-- Zone Casting
local function StartZoneCast()
    task.spawn(function()
        while State.AutoZoneCast do
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    local bobber = tool:FindFirstChild("bobber")
                    if bobber then
                        -- Extend rope
                        local rope = bobber:FindFirstChild("RopeConstraint")
                        if rope then rope.Length = 200000 end

                        local zoneName = State.SelectedZone
                        local posFunc  = ZoneCastPositions[zoneName]
                        if posFunc then
                            local fishZones = Workspace:FindFirstChild("zones") and Workspace.zones:FindFirstChild("fishing")
                            local zone = fishZones and fishZones:FindFirstChild(zoneName)
                            local newCF = posFunc(zone or {Position = Vector3.zero})
                            bobber.CFrame = newCF

                            -- Invisible platform so bobber stays
                            local existing = bobber:FindFirstChild("_platform")
                            if not existing then
                                local plat = Instance.new("Part")
                                plat.Name = "_platform"
                                plat.Size = Vector3.new(10, 1, 10)
                                plat.Position = bobber.Position + Vector3.new(0, -4, 0)
                                plat.Anchored = true
                                plat.Transparency = 1
                                plat.CanCollide = false
                                plat.Parent = bobber
                            end
                        end
                    end
                end
            end
            task.wait(0.01)
        end
    end)
end

-- Webhook
local function StartWebhook()
    task.spawn(function()
        while State.WebhookOn do
            task.wait(State.WebhookDelay)
            if State.WebhookUrl == "" then continue end

            local ok, _ = pcall(function()
                local money = LocalPlayer.leaderstats["C$"].Value
                local lvl   = LocalPlayer.leaderstats.Level.Value
                local uid   = LocalPlayer.UserId
                local t     = os.time()
                local embed = {
                    title  = "Fisch Hub Log",
                    color  = 0x7B52AB,
                    fields = {
                        { name = "Player",    value = "https://www.roblox.com/users/"..uid.."/profile" },
                        { name = "C$",        value = tostring(money), inline = true },
                        { name = "Level",     value = tostring(lvl),   inline = true },
                        { name = "Time",      value = os.date("!%Y-%m-%dT%H:%M:%SZ", t) },
                    },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", t),
                }
                ;(syn and syn.request or http_request)({
                    Url    = State.WebhookUrl,
                    Method = "POST",
                    Headers= { ["Content-Type"] = "application/json" },
                    Body   = HttpService:JSONEncode({
                        username   = "Fisch Hub",
                        avatar_url = "https://i.imgur.com/placeholder.png",
                        embeds     = { embed },
                    }),
                })
            end)
        end
    end)
end

