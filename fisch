-- Sell helpers
local function SellAll()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local savedCF = root.CFrame
    local wasFreeze = State.AutoFreeze

    if wasFreeze then State.AutoFreeze = false end

    root.CFrame = CFrame.new(464, 151, 232)
    task.wait(0.5)
    pcall(function()
        Workspace:WaitForChild("world"):WaitForChild("npcs")
            :WaitForChild("Marc Merchant"):WaitForChild("merchant")
            :WaitForChild("sellall"):InvokeServer()
    end)
    task.wait(3)
    root.CFrame = savedCF

    if wasFreeze then
        State.AutoFreeze = true
        StartFreeze()
    end
end

