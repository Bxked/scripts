-- ================================================
-- ORE FARMING LOGIC
-- ================================================
local function setFarming(state)
	farming = state
	if farming then
		oreStatusLabel.Text = "Status: ● RUNNING"
		oreStatusLabel.TextColor3 = Color3.fromRGB(0, 220, 100)
		oreBtn.Text = "■  STOP ORE FARMING"
		oreBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
		stroke.Color = Color3.fromRGB(0, 200, 100)

		farmThread = task.spawn(function()
			while farming do
				task.wait()
				pcall(function()
					ReplicatedStorage.Packages.Knit.Services.OreService.RE.RequestRandomOre:FireServer()
				end)
				oreCount += 1
				oreCountLabel.Text = "Requests: " .. oreCount
			end
		end)
	else
		oreStatusLabel.Text = "Status: STOPPED"
		oreStatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
		oreBtn.Text = "▶  START ORE FARMING"
		oreBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 80)
		if not drilling then stroke.Color = Color3.fromRGB(60, 60, 80) end
		if farmThread then task.cancel(farmThread) farmThread = nil end
	end
end

oreBtn.MouseButton1Click:Connect(function() setFarming(not farming) end)

-- ================================================
-- DRILL COLLECT LOGIC
-- ================================================
local function setDrilling(state)
	drilling = state
	if drilling then
		drillStatusLabel.Text = "Status: ● RUNNING"
		drillStatusLabel.TextColor3 = Color3.fromRGB(100, 180, 255)
		drillBtn.Text = "■  STOP DRILL COLLECT"
		drillBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
		stroke.Color = Color3.fromRGB(100, 180, 255)

		drillThread = task.spawn(function()
			while drilling do
				local drillsFolder = workspace.Plots.Plot:FindFirstChild("Drills")
				if drillsFolder then
					local drills = drillsFolder:GetChildren()
					drillStatusLabel.Text = "Status: ● RUNNING (" .. #drills .. " drills)"
					for _, drill in ipairs(drills) do
						if not drilling then break end
						pcall(function()
							ReplicatedStorage.Packages.Knit.Services.PlotService.RE.CollectDrill:FireServer(drill)
						end)
						drillCount += 1
						drillCountLabel.Text = "Collects: " .. drillCount
						task.wait()
					end
				else
					drillStatusLabel.Text = "Status: ⚠ Drills folder not found"
					task.wait(1)
				end
				task.wait()
			end
		end)
	else
		drillStatusLabel.Text = "Status: STOPPED"
		drillStatusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
		drillBtn.Text = "▶  START DRILL COLLECT"
		drillBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 220)
		if not farming then stroke.Color = Color3.fromRGB(60, 60, 80) end
		if drillThread then task.cancel(drillThread) drillThread = nil end
	end
end

drillBtn.MouseButton1Click:Connect(function() setDrilling(not drilling) end)

-- ================================================
-- UNLOAD
-- ================================================
local unloaded = false
local renderConnection

local function unload()
	if unloaded then return end
	unloaded = true
	setFarming(false)
	setDrilling(false)
	if renderConnection then renderConnection:Disconnect() end
	screenGui:Destroy()
	print("[OreFarmer] Script unloaded.")
end

unloadBtn.MouseButton1Click:Connect(unload)

-- ================================================
-- RAYCAST
-- ================================================
renderConnection = RunService.RenderStepped:Connect(function()
	local unitRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {player.Character or workspace}

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * RAY_LENGTH, raycastParams)
	rayLabel.Text = result and result.Instance and ("Raycast: " .. result.Instance.Name) or "Raycast: None"
end)

