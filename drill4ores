-- ================================================
-- LOGIC
-- ================================================
local requestCount = 0

local function setFarming(state)
	farming = state
	if farming then
		statusLabel.Text = "Status: ● RUNNING"
		statusLabel.TextColor3 = Color3.fromRGB(0, 220, 100)
		toggleBtn.Text = "■  STOP FARMING"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		stroke.Color = Color3.fromRGB(0, 200, 100)

		farmThread = task.spawn(function()
			while farming do
				task.wait()
				pcall(function()
					ReplicatedStorage.Packages.Knit.Services.OreService.RE.RequestRandomOre:FireServer()
				end)
				requestCount += 1
				counterLabel.Text = "Requests: " .. requestCount
			end
		end)
	else
		statusLabel.Text = "Status: STOPPED"
		statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
		toggleBtn.Text = "▶  START FARMING"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 80)
		stroke.Color = Color3.fromRGB(80, 80, 120)
		if farmThread then
			task.cancel(farmThread)
			farmThread = nil
		end
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	setFarming(not farming)
end)

-- ================================================
-- UNLOAD
-- ================================================
local unloaded = false
local renderConnection

local function unload()
	if unloaded then return end
	unloaded = true

	-- Stop farming
	setFarming(false)

	-- Disconnect raycast loop
	if renderConnection then
		renderConnection:Disconnect()
	end

	-- Destroy UI
	screenGui:Destroy()

	print("[OreFarmer] Script unloaded.")
end

unloadBtn.MouseButton1Click:Connect(unload)

-- ================================================
-- RAYCAST (updates every frame, shows what mouse hovers)
-- ================================================
renderConnection = RunService.RenderStepped:Connect(function()
	local unitRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {player.Character or workspace}

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * RAY_LENGTH, raycastParams)
	if result and result.Instance then
		rayLabel.Text = "Raycast: " .. result.Instance.Name
	else
		rayLabel.Text = "Raycast: None"
	end
end)

-- ================================================
-- TOGGLE UI VISIBILITY
-- ================================================
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == TOGGLE_KEY then
		frame.Visible = not frame.Visible
	end
end)
