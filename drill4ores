local function makeCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function makeLabel(parent, text, size, pos, color, font, xAlign)
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or Color3.fromRGB(200, 200, 200)
	l.TextSize = 12
	l.Font = font or Enum.Font.Gotham
	l.TextXAlignment = xAlign or Enum.TextXAlignment.Center
	l.Parent = parent
	return l
end

local function makeButton(parent, text, pos, size, bg)
	local b = Instance.new("TextButton")
	b.Size = size or UDim2.new(1, -20, 0, 30)
	b.Position = pos
	b.BackgroundColor3 = bg or Color3.fromRGB(0, 160, 80)
	b.Text = text
	b.TextColor3 = Color3.fromRGB(255, 255, 255)
	b.TextSize = 12
	b.Font = Enum.Font.GothamBold
	b.BorderSizePixel = 0
	b.Parent = parent
	makeCorner(b, 7)
	return b
end

