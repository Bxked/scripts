local PlayersTab = Window:CreateTab("Players", 4483362458)

-- helper to get player list (excluding local)
local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    if #names == 0 then names = {"No players found"} end
    return names
end

-- ---- TELEPORT TO PLAYER ----
local selectedTpPlayer = nil

PlayersTab:CreateSection("Teleport to Player")

local tpDropdown = PlayersTab:CreateDropdown({
    Name = "Select Player",
    Options = getPlayerNames(),
    CurrentOption = {"Select..."},
    Flag = "TpPlayerDropdown",
    Callback = function(selected)
        selectedTpPlayer = selected[1]
    end,
})

PlayersTab:CreateButton({
    Name = "Refresh Player List",
    Callback = function()
        local names = getPlayerNames()
        tpDropdown:Refresh(names, true)
        Rayfield:Notify({Title="Refreshed", Content="Player list updated.", Duration=2})
    end,
})

PlayersTab:CreateButton({
    Name = "Teleport",
    Callback = function()
        if not selectedTpPlayer or selectedTpPlayer == "Select..." or selectedTpPlayer == "No players found" then
            Rayfield:Notify({Title="Error", Content="Select a valid player first.", Duration=3})
            return
        end
        local target = Players:FindFirstChild(selectedTpPlayer)
        if not target or not target.Character then
            Rayfield:Notify({Title="Error", Content="Player not found or has no character.", Duration=3})
            return
        end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        local theirRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and theirRoot then
            myRoot.CFrame = theirRoot.CFrame + Vector3.new(3, 0, 0)
            Rayfield:Notify({Title="Teleported", Content="Teleported to " .. selectedTpPlayer, Duration=2})
        end
    end,
})

PlayersTab:CreateDivider()

-- ---- FLING PLAYER ----
local selectedFlingPlayer = nil
local flingPowerVal = 200

PlayersTab:CreateSection("Fling Player")

local flingDropdown = PlayersTab:CreateDropdown({
    Name = "Select Player",
    Options = getPlayerNames(),
    CurrentOption = {"Select..."},
    Flag = "FlingPlayerDropdown",
    Callback = function(selected)
        selectedFlingPlayer = selected[1]
    end,
})

PlayersTab:CreateSlider({
    Name = "Fling Power",
    Range = {100, 5000},
    Increment = 100,
    Suffix = "force",
    CurrentValue = 200,
    Flag = "FlingPower",
    Callback = function(val)
        flingPowerVal = val
    end,
})

PlayersTab:CreateButton({
    Name = "Refresh Player List",
    Callback = function()
        local names = getPlayerNames()
        flingDropdown:Refresh(names, true)
        Rayfield:Notify({Title="Refreshed", Content="Player list updated.", Duration=2})
    end,
})

PlayersTab:CreateButton({
    Name = "Fling!",
    Callback = function()
        if not selectedFlingPlayer or selectedFlingPlayer == "Select..." or selectedFlingPlayer == "No players found" then
            Rayfield:Notify({Title="Error", Content="Select a valid player first.", Duration=3})
            return
        end

        local target = Players:FindFirstChild(selectedFlingPlayer)
        if not target or not target.Character then
            Rayfield:Notify({Title="Error", Content="Target has no character.", Duration=3})
            return
        end

        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")

        if not myRoot or not targetRoot then return end

        -- Teleport to target, apply velocity, then teleport back
        local myOriginalCF = myRoot.CFrame
        myRoot.CFrame = targetRoot.CFrame

        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(
            math.random(-flingPowerVal, flingPowerVal),
            flingPowerVal,
            math.random(-flingPowerVal, flingPowerVal)
        )
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Parent = myRoot

        task.delay(0.1, function()
            bv:Destroy()
            myRoot.CFrame = myOriginalCF
        end)

        Rayfield:Notify({Title="Flung!", Content="Flung " .. selectedFlingPlayer, Duration=2})
    end,
})

